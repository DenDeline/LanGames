<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <Target Name="BuildFrontendForPublish"
          BeforeTargets="ResolveProjectStaticWebAssets;ResolveCurrentProjectStaticWebAssetsInputs"
          Condition="'$(_IsPublishing)' == 'true' and '$(NoBuild)' != 'true'">
    <ItemGroup>
      <Content Remove="wwwroot/**/*" />
    </ItemGroup>

    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="pnpm install --frozen-lockfile" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="pnpm build" />

    <ItemGroup>
      <Content Include="wwwroot/**/*" />
    </ItemGroup>
  </Target>

  <!-- ONNX Runtime 1.30 also copies Windows PE DLLs into Unix Native AOT output.
       They cannot load on these target platforms; keep each target's native library. -->
  <Target Name="PruneWindowsOnnxRuntimeLibrariesFromUnixPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'linux-x64'">
    <Delete Files="$(PublishDir)onnxruntime.dll;$(PublishDir)onnxruntime_providers_shared.dll" />
  </Target>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Include="Models/aot-smoke.onnx" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Models/hard-v1.onnx" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LanPong.Tests" />
    <InternalsVisibleTo Include="LanPong.TrainingData" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>
</Project>
